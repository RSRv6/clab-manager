[Unit]
Description=Virtual Labs Management - VM Agent API
After=network.target

[Service]
Type=simple
User={{ vlm_app_user }}
Group={{ vlm_app_user }}
WorkingDirectory={{ vlm_app_dir }}/vm-agent
EnvironmentFile=/etc/default/vlm-agent
ExecStart={{ vlm_app_dir }}/.venv/bin/uvicorn src.agent:app --host ${AGENT_HOST} --port ${AGENT_PORT}
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
